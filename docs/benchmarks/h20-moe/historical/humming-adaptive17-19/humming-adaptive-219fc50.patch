@@ -133,3 +133,80 @@ def test_masked_layout(quant_mode, zero_invalid, activation_type, layout):
         valid_rows=valid_rows,
         zero_invalid=zero_invalid,
     )
+
+
+@pytest.mark.parametrize("capacity", [7, 2048])
+@pytest.mark.parametrize("count_dtype", [torch.int32, torch.int64])
+@pytest.mark.parametrize("use_pdl", [False, True])
+def test_grouped_mask_graph_changing_counts(capacity, count_dtype, use_pdl):
+    """Replay one graph across sparse, skewed, empty and recovered batches."""
+    torch.manual_seed(17)
+    experts, hidden = 3, 2304
+    inputs = torch.randn(experts * capacity, hidden * 2, device="cuda", dtype=torch.bfloat16)
+    counts = torch.full((experts,), capacity, device="cuda", dtype=count_dtype)
+    outputs = torch.empty((experts * capacity, hidden), device="cuda", dtype=torch.float8_e4m3fn)
+    scales = torch.empty((experts * capacity, hidden // 128), device="cuda", dtype=torch.float32)
+    activation = ACTIVATION_TYPE_IMPL_TEST_MAP[ActivationType("binary_split")]["impl"]
+    options = dict(
+        quant_mode="dynamic_group",
+        quant_dtype="float8e4m3",
+        quant_group_size=128,
+        group_scale_dtype="float32",
+        activation_type="binary_split",
+        layout="grouped_mask",
+        expert_tokens=counts,
+        zero_invalid=False,
+    )
+
+    def run():
+        return process_input(
+            inputs,
+            outputs=outputs,
+            group_scales=scales,
+            activation_impl=activation,
+            use_pdl=use_pdl,
+            **options,
+        )
+
+    run()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        run()
+    for values in (
+        [1, 3, 0],
+        [capacity, 0, 0],
+        [0, 0, 0],
+        [min(6, capacity)] * experts,
+        [min(12, capacity)] * experts,
+        [min(24, capacity)] * experts,
+        [min(48, capacity)] * experts,
+        [min(96, capacity)] * experts,
+        [capacity] * experts,
+        [2, 0, 1],
+    ):
+        counts.copy_(torch.tensor(values, dtype=count_dtype, device="cuda"))
+        inputs.mul_(-0.75)
+        outputs.fill_(7)
+        scales.fill_(7)
+        graph.replay()
+        expected = process_input_ref(inputs, **options)
+        valid = (torch.arange(capacity, device="cuda")[None, :] < counts[:, None]).flatten()
+        actual = (outputs, scales, None)
+        assert_process_input_close(
+            actual,
+            expected,
+            quant_mode=InputQuantizationMode.DynamicGroup,
+            quant_dtype="float8e4m3",
+            group_scale_dtype="float32",
+            quant_group_size=128,
+            valid_rows=valid,
+            zero_invalid=False,
+        )
+        assert torch.all(outputs.float()[~valid] == 7)
+        assert torch.all(scales[~valid] == 7)
+        graph_output = outputs.float().clone()
+        graph_scales = scales.clone()
+        run()
+        torch.testing.assert_close(outputs.float(), graph_output, rtol=0, atol=0)
+        torch.testing.assert_close(scales, graph_scales, rtol=0, atol=0)
